# Build output
build

# Debug artifacts (GDB scripts, captured stderr, sanity/trace dumps)
*.gdb
sanity_*.txt
stderr.txt

# Third-party / reference source trees (not tracked by name)
third_party

# Documentation generated by Doxygen
docs

# Example output files
example.output.*

# Task documents
tasks

# Test output (e.g. PNGs written by encode tests for verification)
tests/out

# JPEG debug script outputs (trace comparison, libjpeg fixture creation)
tests/data/jpeg/trace_ours.txt
tests/data/jpeg/trace_ref.txt
tests/data/jpeg/progressive_8x8_libjpeg.ppm
tests/data/jpeg/progressive_8x8_libjpeg.jpg

# Pycache files (for generated test fixtures, in any directory)
**/__pycache__
