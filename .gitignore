# Build output
build

# Debug artifacts (GDB scripts, captured stderr, sanity/trace dumps)
*.gdb
*.txt

# IDE / CTest run output (not used by project Makefile)
Testing

# Third-party / reference source trees (not tracked by name)
third_party

# Compiled libjpeg oracle tools. The sources are tracked in
# tests/tools/jpeg-oracle; the binaries they build are not, in either the
# build directory or the fixture directory they were once committed to.
tests/tools/jpeg-oracle/build
tests/data/jpeg/dump_jpeg_coef_ref*
tests/data/jpeg/dump_jpeg_pixels_ref*
tests/data/jpeg/dump_jpeg_raw_first_mcu*
tests/data/jpeg/encode_libjpeg_*

# Compiled bmplib oracle tool. The source is tracked in tests/tools/bmp-oracle;
# the binary it builds is not, and neither is the bmplib checkout under
# third_party that it links against.
tests/tools/bmp-oracle/build

# Documentation generated by Doxygen
docs

# Example output files
example.output.*

# Task documents
tasks

# Test output (e.g. PNGs written by encode tests for verification)
tests/out

# Stray output under test data (use tests/out instead)
tests/data/out


# Pycache files (for generated test fixtures, in any directory)
**/__pycache__

# Compiled giflib oracle tool. The source is tracked in tests/tools/gif-oracle;
# the binary it builds is not. Rebuild it with `make gif-oracle-tools`, which
# needs the giflib headers (Debian/Ubuntu: libgif-dev).
tests/tools/gif-oracle/build
