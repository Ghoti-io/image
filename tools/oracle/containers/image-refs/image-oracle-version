#!/bin/sh
# What oracle_env.py's probe runs: one line naming the reference that will
# answer, taken from the reference itself rather than from the image's tag.
#
# One script for five references because they share an image. Each arm reports
# the thing that decides whether a disagreement can be a defect: the library's
# own version for the three decoders, and the pinned commit for the two that
# are a git checkout rather than a release.
set -eu
case "${1:-}" in
  pillow)   exec python3 -c 'from PIL import Image; print("Pillow", Image.__version__)' ;;
  libjpeg)  exec /usr/local/bin/probe_jpeg ;;
  giflib)   exec /usr/local/bin/probe_gif ;;
  bmplib)   printf 'bmplib %s\n' "$(cat /opt/bmplib.ref)" ;;
  bmpsuite) printf 'bmpsuite %s\n' "$(cat /opt/bmpsuite.ref)" ;;
  pixbuf)   exec python3 -c 'import gi; gi.require_version("GdkPixbuf", "2.0"); from gi.repository import GdkPixbuf; print("GdkPixbuf %d.%d.%d" % (GdkPixbuf.PIXBUF_MAJOR, GdkPixbuf.PIXBUF_MINOR, GdkPixbuf.PIXBUF_MICRO))' ;;
  netpbm)   printf 'netpbm %s\n' "$(bmptopnm --version 2>&1 | sed -n 's/.*Netpbm \([0-9.]*\).*/\1/p' | head -1)" ;;
  *)        printf 'image-oracle-version: no such reference: %s\n' "${1:-}" >&2
            exit 2 ;;
esac
