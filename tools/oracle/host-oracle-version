#!/bin/sh
# What oracle_env.py's probe runs in host mode: one line naming the reference
# this machine would answer with.
#
# The container's arms are in containers/image-refs/image-oracle-version. These
# are deliberately the *same questions asked the same way* - the two C probes
# are the same two source files the image compiles, built here against this
# machine's headers, so that a host-versus-container diff compares two
# machines' libraries rather than two ways of asking.
#
# A missing compiler, a missing header or a missing checkout is an error here
# and not an empty answer: oracle_env.check_pin() treats an empty version as a
# mismatch, but it would name the pin rather than the cause.
set -eu

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
probes="$here/containers/image-refs"

build_and_run() {
  src=$1
  shift
  command -v cc >/dev/null 2>&1 || {
    printf 'host mode needs cc to build %s\n' "$src" >&2
    exit 2
  }
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  cc -O2 -o "$tmp/probe" "$probes/$src" "$@" || {
    printf 'could not build %s against this machine'"'"'s headers\n' "$src" >&2
    exit 2
  }
  "$tmp/probe"
}

git_ref() {
  dir="$root/third_party/$1"
  [ -d "$dir/.git" ] || {
    printf '%s is not checked out; run tools/oracle/fetch.sh %s\n' "$1" "$1" >&2
    exit 2
  }
  printf '%s %s\n' "$1" "$(git -C "$dir" rev-parse HEAD)"
}

case "${1:-}" in
  pillow)   exec python3 -c 'from PIL import Image; print("Pillow", Image.__version__)' ;;
  libjpeg)  build_and_run probe_jpeg.c $(pkg-config --cflags --libs libjpeg 2>/dev/null || echo -ljpeg) ;;
  giflib)   build_and_run probe_gif.c -lgif ;;
  bmplib)   git_ref bmplib ;;
  bmpsuite) git_ref bmpsuite ;;
  pixbuf)   exec python3 -c 'import gi; gi.require_version("GdkPixbuf", "2.0"); from gi.repository import GdkPixbuf; print("GdkPixbuf %d.%d.%d" % (GdkPixbuf.PIXBUF_MAJOR, GdkPixbuf.PIXBUF_MINOR, GdkPixbuf.PIXBUF_MICRO))' ;;
  netpbm)   printf 'netpbm %s\n' "$(bmptopnm --version 2>&1 | sed -n 's/.*Netpbm \([0-9.]*\).*/\1/p' | head -1)" ;;
  *)        printf 'host-oracle-version: no such reference: %s\n' "${1:-}" >&2
            exit 2 ;;
esac
