"""Run one command against a pinned reference.

    oracle-exec [--scratch DIR]... [--print] <name> -- <argv...>

`unicode` and `font` are asked their oracle questions by Python differentials,
which import oracle_env and build an argv. This library's questions come mostly
from gtest binaries, which build a shell command string; so the decision of how
a reference is spelled is handed out here as a command rather than imported.

It does not fail open. A missing engine, a missing image or a version that does
not match `containers/IMAGES` exits **2** with the reason on stderr, which is
distinct from the reference running and returning non-zero. A caller that
cannot tell those apart is one that will record "no oracle" for "the oracle
said no", and this library has a test that turns exactly that distinction into
a pass or a failure.

`--scratch DIR` declares a directory the reference must be able to write. In
container mode it becomes a read-write mount; in host mode it is ignored, which
is the only asymmetry and is why a tool that forgets to declare one still works
on the host and fails in the container. The directory must exist: creating it
here would hide the same mistake.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import oracle_env  # noqa: E402


def main(argv):
    scratch = []
    show = False
    i = 1
    while i < len(argv) and argv[i].startswith("--"):
        if argv[i] == "--scratch":
            if i + 1 >= len(argv):
                sys.stderr.write("oracle-exec: --scratch needs a directory\n")
                return 2
            scratch.append(os.path.abspath(argv[i + 1]))
            i += 2
        elif argv[i] == "--print":
            show = True
            i += 1
        elif argv[i] == "--":
            break
        else:
            sys.stderr.write("oracle-exec: no such option: %s\n" % argv[i])
            return 2
    if i >= len(argv):
        sys.stderr.write(__doc__.strip().splitlines()[2].strip() + "\n")
        return 2
    name = argv[i]
    i += 1
    if i < len(argv) and argv[i] == "--":
        i += 1
    inner = argv[i:]
    if not inner:
        sys.stderr.write("oracle-exec: nothing to run against %s\n" % name)
        return 2
    for path in scratch:
        if not os.path.isdir(path):
            sys.stderr.write(
                "oracle-exec: scratch directory does not exist: %s\n"
                "The caller declares it; creating it here would hide the "
                "case where the caller named the wrong one.\n" % path)
            return 2
    try:
        # check_pin rather than ensure: reaching the image is not the question,
        # reaching the reference the pin names is. They differ exactly when
        # someone rebuilds the image from a moved Containerfile and keeps the
        # tag, which is the failure a built-here image has instead of a digest.
        oracle_env.check_pin(name)
        cmd = oracle_env.command(name, inner, scratch=scratch)
    except oracle_env.OracleUnavailable as exc:
        sys.stderr.write("oracle-exec: %s\n" % exc)
        return 2
    if show:
        sys.stdout.write(" ".join(cmd) + "\n")
        return 0
    try:
        os.execvp(cmd[0], cmd)
    except OSError as exc:
        sys.stderr.write("oracle-exec: could not run %s: %s\n" % (cmd[0], exc))
        return 2
    return 2  # unreachable; execvp does not return


if __name__ == "__main__":
    sys.exit(main(sys.argv))
